        ],
        "type": "object"
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "github-search_commits",
      "description": "[github] Search for commits across GitHub repositories using GitHub's commit search syntax. Useful for finding specific changes, authors, or messages across one or many repositories. Searches the default branch only.",
      "parameters": {
        "properties": {
          "order": {
            "description": "Sort order",
            "enum": [
              "asc",
              "desc"
            ],
            "type": "string"
          },
