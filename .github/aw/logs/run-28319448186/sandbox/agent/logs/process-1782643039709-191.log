  {
    "type": "function",
    "function": {
      "name": "github-actions_list",
      "description": "[github] Tools for listing GitHub Actions resources.\nUse this tool to list workflows in a repository, or list workflow runs, jobs, and artifacts for a specific workflow or workflow run.\n",
      "parameters": {
        "properties": {
          "method": {
